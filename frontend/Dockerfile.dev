FROM node:20-alpine

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Install dependencies first for caching
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install

# Copy source code files
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Run in dev mode exposed to host network
CMD ["pnpm", "dev", "--host"]
