{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Go Backend",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend/cmd/api",
      "envFile": "${workspaceFolder}/backend/.env",
      "showLog": true
    },
    {
      "name": "Debug Go Tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/backend/tests",
      "envFile": "${workspaceFolder}/backend/tests/test.env",
      "showLog": true
    },
    {
      "name": "Debug Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Backend + Frontend)",
      "configurations": [
        "Debug Go Backend",
        "Debug Frontend (Chrome)"
      ]
    }
  ]
}